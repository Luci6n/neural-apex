{
  "name": "neural-apex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"python -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 8787\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "python -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 8787",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8787"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
